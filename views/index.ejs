<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>whatsapp</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <h1>All  chats:</h1>
    <form method="GET" action="/chats/new"><button>Add your new chat</button></form>
    <br>
     <% for(let chat of chats){%>
    <div class="chat">
        From: <i><%= chat.from %></i>
        <div class="msg">
         message:- <%= chat.msg %>
         <br><br>
         <form method="GET" action="/chats/<%= chat._id %>/edit"><button>Edit</button></form>
         <br>
         <form method="POST" action="/chats/<%= chat._id %>?_method=DELETE" class="delete-form">
            <button type="submit">Delete</button>
         </form>
        </div>
        To: <i><%= chat.to %></i>
        <hr/>
        <p> <%= chat.date_at.toString().split(" ")[4] %> </p>
        <p> <%= chat.date_at.toString().split(" ").slice(0,4).join("-") %> </p>
    </div>
   <br><br>
   
<% } %>
<script src="/app.js"></script>
</body>
</html>