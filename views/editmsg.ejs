<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Edit Item</title>
</head>
<body>
    <h3>Edit your message:-</h3>
    <p>which is send from <b><%= chats.from %></b> to  <b><%= chats.to %></b></p>
    <form method="POST" action="/chats/<%= chats._id %>?_method=PUT">
        <textarea type="text" name="msg" placeholder="Edit your message here!" required><%= chats.msg %></textarea>
        <br><br>
        <button type="submit">Save Changes</button>
    </form>

</body>
</html>
